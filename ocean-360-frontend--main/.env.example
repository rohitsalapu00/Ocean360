# Map Tile Provider Configuration (Optional)
# If left blank, the app defaults to free CARTO Light Positron & Dark Matter tiles (no key needed).
# You can also enter or update your key directly inside the app using the "Map Key" button in the map toolbar.

# Option 1: CARTO API Key (e.g. for enterprise or high-volume tile requests)
# VITE_CARTO_API_KEY=your_carto_api_key_here

# Option 2: Mapbox (e.g. pk.eyJ1...)
# VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# Option 3: Stadia Maps / Alidade Smooth Dark
# VITE_STADIA_API_KEY=your_stadia_key_here

# Option 4: Generic / Custom Tile URL template
# VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png?api_key={apiKey}
# VITE_MAP_API_KEY=your_api_key_here
